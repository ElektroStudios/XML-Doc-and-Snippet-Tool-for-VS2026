<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Snippet_Tool_2026</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Native xUnit v3 runner plus VSTest/Test Explorer integration. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.Framework" Version="18.12.1603" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.Interop" Version="18.12.1603" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Snippet Tool 2026/helpers/DTE Initializer.vb" Link="Production/DTE Initializer.vb" />
    <Compile Include="../Snippet Tool 2026/helpers/Logger.vb" Link="Production/Logger.vb" />
    <Compile Include="../Snippet Tool 2026/core/Package Guids.vb" Link="Production/Package Guids.vb" />
    <Compile Include="../Snippet Tool 2026/core/Command IDs.vb" Link="Production/Command IDs.vb" />
    <Compile Include="../Snippet Tool 2026/core/Docs Constants.vb" Link="Production/Docs Constants.vb" />
    <Compile Include="../Snippet Tool 2026/core/XmlDocOperation.vb" Link="Production/XmlDocOperation.vb" />
    <Compile Include="../Snippet Tool 2026/helpers/XmlDocumentationFormatting.vb" Link="Production/XmlDocumentationFormatting.vb" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../Snippet Tool 2026/My Project/AssemblyInfo.vb" Link="Fixtures/AssemblyInfo.vb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Snippet Tool 2026/Snippet Tool.vsct" Link="Fixtures/Snippet Tool.vsct" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Snippet Tool 2026/source.extension.vsixmanifest" Link="Fixtures/source.extension.vsixmanifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Snippet Tool 2026/Snippet Tool 2026.vbproj" Link="Fixtures/Snippet Tool 2026.vbproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Snippet Tool 2026/core/Snippet_Tool_2026Package.vb" Link="Fixtures/Snippet_Tool_2026Package.vb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Snippet Tool 2026/core/Command Callbacks.vb" Link="Fixtures/Command Callbacks.vb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Snippet Tool 2026/core/Command EventHandlers.vb" Link="Fixtures/Command EventHandlers.vb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
